{
  "name": "com.evidencepair.shopify.termslock",
  "version": "1.0.0",
  "private": true,
  "description": "TermsLock: B2B PO, Tax & Net-30 Checkout Rules for Shopify Functions (API 2026-10)",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev:server": "node src/server.ts",
    "build:wasm": "esbuild extensions/b2b-checkout-validator/src/run.ts --bundle --platform=neutral --format=esm --outfile=dist/validator.bundle.mjs && esbuild extensions/b2b-payment-gate/src/run.ts --bundle --platform=neutral --format=esm --outfile=dist/payment-gate.bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:assets": "python3 scripts/generate_store_assets.py"
  },
  "dependencies": {
    "@shopify/polaris": "^13.9.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
