{
  "name": "com.evidencepair.shopify.termslock",
  "version": "1.0.0",
  "private": true,
  "description": "TermsLock: B2B PO, Tax & Net-30 Checkout Rules for Shopify Functions (API 2026-10)",
  "type": "module",
  "scripts": {
    "start": "node src/server.ts",
    "dev:server": "node src/server.ts",
    "build": "npm run build:wasm && node scripts/build-static-assets.mjs",
    "build:wasm": "esbuild extensions/b2b-checkout-validator/src/run.ts --bundle --platform=neutral --format=esm --outfile=dist/validator.bundle.mjs && esbuild extensions/b2b-payment-gate/src/run.ts --bundle --platform=neutral --format=esm --outfile=dist/payment-gate.bundle.mjs",
    "deploy:cf": "npm run build && wrangler deploy",
    "deploy:shopify": "shopify app deploy --allow-updates --no-input",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:assets": "python3 scripts/generate_store_assets.py"
  },
  "dependencies": {
    "@shopify/polaris": "^13.9.5",
    "@shopify/polaris-icons": "^9.3.1",
    "@shopify/shopify_function": "~2.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "playwright": "^1.64.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.0"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
